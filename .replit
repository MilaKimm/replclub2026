modules = ["nodejs-20", "postgresql-16"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "REPL CLUB"

[[workflows.workflow]]
name = "REPL CLUB"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server/index.mjs"
waitForPort = 5000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "install", "--omit=dev"]
run = ["node", "server/index.mjs"]
